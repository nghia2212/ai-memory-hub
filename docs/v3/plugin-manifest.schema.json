{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V3 MCP plugin manifest proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "source",
    "runtime",
    "startup",
    "resources",
    "permissions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "version"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "license": {
          "type": "string"
        }
      }
    },
    "runtime": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "executable",
            "args"
          ],
          "properties": {
            "kind": {
              "const": "stdio"
            },
            "executable": {
              "type": "string",
              "minLength": 1
            },
            "args": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "maxLength": 4096
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "url"
          ],
          "properties": {
            "kind": {
              "enum": [
                "http",
                "sse",
                "desktop"
              ]
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "image"
          ],
          "properties": {
            "kind": {
              "const": "container"
            },
            "image": {
              "type": "string",
              "pattern": "@sha256:[a-f0-9]{64}$"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 64
            }
          }
        }
      ]
    },
    "startup": {
      "enum": [
        "on-demand",
        "manual",
        "always-on"
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_mb",
        "timeout_seconds"
      ],
      "properties": {
        "memory_mb": {
          "type": "integer",
          "minimum": 32,
          "maximum": 8192
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        },
        "idle_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "exclusive": {
          "type": "boolean"
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesystem",
        "network",
        "secret_refs"
      ],
      "properties": {
        "filesystem": {
          "enum": [
            "none",
            "project-read",
            "worktree-write"
          ]
        },
        "network": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 32
        },
        "secret_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]{1,80}$"
          },
          "maxItems": 16
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 16
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 16
    }
  }
}
