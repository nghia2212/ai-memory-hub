# AI Memory Hub environment template.
# Run `pwsh -File scripts/init-env.ps1` (or `powershell -File scripts/init-env.ps1`)
# to generate ignored local `.env` with secure random tokens. Never commit `.env`.

HUB_PORT=8080
CODEBASE_PORT=8081
BRIDGE_PORT=8082

# Internal service tokens (provisioned locally by scripts/init-env.ps1)
BRIDGE_READ_TOKEN=
BRIDGE_WRITE_TOKEN=
BRIDGE_ADMIN_TOKEN=
BRIDGE_WORKER_TOKEN=
CODEBASE_TOKEN=
CODEBASE_READ_TOKEN=
CODEBASE_ADMIN_TOKEN=

# Vietnamese Admin Dashboard (loopback only)
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
DASHBOARD_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Optional Hermes background summarizer (DISABLED by default; no local LLM)
HERMES_ENABLED=false
HERMES_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
HERMES_APPROVED_PROJECTS=
